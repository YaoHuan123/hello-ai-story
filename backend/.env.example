# 复制为 backend/.env 并填入真实值。勿提交 .env。

# ---------- 基础服务 ----------
PORT=3001
# Web 壳层语言（zh | en）；前端 Web 从 GET /api/health 读取。详见 docs/i18n.md
APP_LOCALE=zh
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
DATA_ROOT=./data
DATA_DB_FILE=./data/app.db
DATA_USERS_ROOT=./data/users

# ---------- 阿里云短信（详见 backend/docs/aliyun-sms.md） ----------
# 真实短信：填齐下列项，并设 ALIYUN_DYPNSAPI_DEV_MOCK=0 或删除该行；GET /api/health → sms.mode=real
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=
ALIYUN_SMS_TEMPLATE_CODE_CHANGE_PHONE_OLD=
ALIYUN_SMS_TEMPLATE_CODE_CHANGE_PHONE_NEW=
ALIYUN_SMS_TEMPLATE_CODE_DELETE_ACCOUNT=
# 可选：号码认证方案名
# ALIYUN_DYPNSAPI_SCHEME_NAME=
# 本地开发默认 mock，验证码固定 123456
ALIYUN_DYPNSAPI_DEV_MOCK=1

# ---------- iOS Sign in with Apple（详见 backend/docs/dual-auth.md） ----------
APPLE_BUNDLE_ID=io.github.com.YaoHuan123.hello-ai-story
# 本地开发 mock：identityToken 固定 dev-apple-mock-token
APPLE_AUTH_DEV_MOCK=1

# ---------- 积分钱包（详见 backend/docs/quiz-rewards.md） ----------
# 本地 mock 充值；production 默认关闭
WALLET_MOCK_RECHARGE=1

# ---------- LLM（必填） ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_MODEL=doubao-seed-2-0-pro-260215

# ---------- TTS（传记 step 180 / 演播室 iv_tts） ----------
# 成片音色：后端按采访 meta.locale 自动选用（传记=男声；演播室=主持女声+嘉宾男声）
TTS_VOICE_ZH_MALE=zh_male_M392_conversation_wvae_bigtts
TTS_VOICE_ZH_FEMALE=zh_female_tianmeixiaoyuan_moon_bigtts
TTS_VOICE_EN_MALE=en_male_adam_mars_bigtts
TTS_VOICE_EN_FEMALE=en_female_sarah_mars_bigtts
TTS_API_URL=https://api.302.ai/doubao/tts_hd
TTS_API_KEY=
TTS_MODEL=doubao_tts_hd
# Node 内置 fetch 连接超时固定 10s；TTS 已用 undici 覆盖，默认连接 60s、响应 120s
# TTS_FETCH_CONNECT_TIMEOUT_MS=60000
# TTS_FETCH_BODY_TIMEOUT_MS=120000
# TTS_HTTP_MAX_RETRIES=3
# TTS_HTTP_RETRY_BASE_MS=2000

# 演播室 iv_duration_align：口播时长与画面 T* 允许偏差 |1−d/T*|（默认 0.12，成片 atempo 微调）
# INTERVIEW_AUDIO_TEMPO_BUDGET=0.12

# 访问 api.302.ai 的 TTS 须配代理（worker 经 EnvHttpProxyAgent 出站；LLM 走火山可直连）
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897

# ---------- 成片 trace（默认 on；见 backend/docs/video-llm-trace.md） ----------
# VIDEO_LLM_TRACE=on
# VIDEO_PIPELINE_TRACE=on

# E2E / 集成测试（可选；未设时回落到 TTS_VOICE_*）
# VIDEO_DEMO_TTS_VOICE=zh_male_M392_conversation_wvae_bigtts
# VIDEO_DEMO_HOST_VOICE=zh_female_tianmeixiaoyuan_moon_bigtts
# VIDEO_DEMO_GUEST_VOICE=zh_male_M392_conversation_wvae_bigtts

# ---------- 文生图（传记 step 240，可选；默认可回落 OPENAI_API_KEY） ----------
# TEXT2IMG_API_KEY=
# TEXT2IMG_MODEL=doubao-seedream-5-0-260128
# TEXT2IMG_SIZE=2848x1600

# ---------- ffmpeg（可选，默认 PATH 中的 ffmpeg） ----------
# FFMPEG_PATH=ffmpeg

# ---------- 访谈出题 trace（默认 on；见 backend/docs/question-trace.md） ----------
# QUESTION_LLM_TRACE=on

# ---------- E2E 验收 ----------
# npm run test:e2e:acceptance
# E2E_VIDEO_RENDER=1   # 追加传记 240→260（文生图+合成，耗时长）
# E2E_BIO_FULL=1       # 无 seed 时跑传记全程 10→230
# E2E_STUDIO_FULL=1    # 无 seed 时跑演播室至 iv_script
