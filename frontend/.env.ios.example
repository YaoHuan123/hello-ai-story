# 复制为 .env.ios.local 后构建（gitignore 已忽略 *.local）
#
# iOS 模拟器（Mac，与宿主机共享网络栈）：
VITE_API_BASE_URL=http://127.0.0.1:3001
#
# 真机调试（与电脑同一 Wi‑Fi）：
# VITE_API_BASE_URL=http://192.168.1.100:3001
#
# 生产（hellotita.top 路径制）：
# VITE_API_BASE_URL=https://hellotita.top/hello-story/api
# VITE_LOCALE=en
#
# 法律页 URL 基址（可选，默认 https://hellotita.top）：
# VITE_LEGAL_SITE_ORIGIN=https://hellotita.top
#
# 活动 / 观看 / 积分钱包（1=开启，0=关闭；美区首版建议 0）
VITE_ENABLE_QUIZ_REWARDS=0
