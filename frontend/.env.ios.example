# 复制为 .env.ios.local 后构建（gitignore 已忽略 *.local）
#
# iOS 模拟器（Mac，与宿主机共享网络栈）：
VITE_API_BASE_URL=http://127.0.0.1:3001
#
# 真机调试（与电脑同一 Wi‑Fi）：
# VITE_API_BASE_URL=http://192.168.1.100:3001
#
# 生产：
# VITE_API_BASE_URL=https://api.yourdomain.com
#
# 界面语言（可选）：zh | en；不设则中文系统→zh，其它→en
# 海外 App Store 包建议：
# VITE_LOCALE=en
