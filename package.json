{
  "name": "hello-story2-fullstack",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:worker": "npm run worker:video --prefix backend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "start:worker": "npm run start:worker --prefix backend",
    "pm2:start": "npm run build:backend && npm run pm2:start --prefix backend",
    "pm2:stop": "npm run pm2:stop --prefix backend",
    "pm2:restart": "npm run pm2:restart --prefix backend",
    "pm2:logs": "npm run pm2:logs --prefix backend"
  }
}
